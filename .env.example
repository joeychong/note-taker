# Never commit a real API key. Existing environment variables override this file.
ELEVENLABS_API_KEY=
STT_AUDIO_DEVICE=default
# system (default), microphone, or both
STT_AUDIO_SOURCE=system
STT_MICROPHONE_DEVICE=default
STT_DIARIZE=false
STT_TIMESTAMPS=false
STT_CHUNK_MS=200
STT_VAD_SILENCE=1.0
STT_OUTPUT_FORMAT=txt
STT_LOG_LEVEL=info
# Optional: omit for automatic language detection.
# STT_LANGUAGE=en
